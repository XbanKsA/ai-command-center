# Copy this file to .env and change what you need. Everything has a sensible default.

# --- Server ---
PORT=8765
# SERVER_NAME=My-Gaming-PC
LOG_LEVEL=info

# --- Discovery ---
DISCOVERY_PORT=37020
BROADCAST_INTERVAL=2.0

# --- Pairing security ---
MAX_PIN_ATTEMPTS=5
LOCKOUT_SECONDS=60

# --- Telemetry ---
TELEMETRY_INTERVAL=1.5

# --- Local AI (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# --- Execution ---
# true = JARVIS only logs actions (safe testing), nothing is launched/closed
DRY_RUN=false
CONFIRM_TIMEOUT=60

# --- Voice ---
VOICE_ENABLED=true
WAKE_WORD_MODEL=hey_jarvis
# 0..1, raise it (e.g. 0.6) if JARVIS wakes up by accident, lower it (0.35) if it misses you
WAKE_THRESHOLD=0.5
# blank = Windows default microphone. Or a device number / name (python tools/check_setup.py lists them)
MIC_DEVICE=
# tiny | base | small | medium | large-v3   (small = good balance, supports Arabic + English)
WHISPER_MODEL=small
# auto = try NVIDIA GPU, fall back to CPU
WHISPER_DEVICE=auto
# blank = auto-detect language each time, or force: en / ar
STT_LANGUAGE=
TTS_VOICE=en-GB-RyanNeural
TTS_VOICE_ARABIC=ar-SA-HamedNeural
SPEAK_RESPONSES=true
