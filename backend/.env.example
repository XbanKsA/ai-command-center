# Copy this file to .env and change what you need. Everything has a sensible default.

# --- Server ---
PORT=8765
# SERVER_NAME=My-Gaming-PC
LOG_LEVEL=info

# --- Discovery ---
DISCOVERY_PORT=37020
BROADCAST_INTERVAL=2.0

# --- Pairing security ---
MAX_PIN_ATTEMPTS=5
LOCKOUT_SECONDS=60

# --- Telemetry ---
TELEMETRY_INTERVAL=1.5

# --- Local AI (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# Two models, only one loaded at a time. Kageon switches automatically (see MODES below).
MODEL_NORMAL=qwen3.5:9b
MODEL_GAMING=qwen3.5:4b
# used if a mode's model isn't downloaded yet
MODEL_FALLBACK=qwen2.5-coder:3b
# keep the active model loaded in VRAM: -1 = forever (fastest), or e.g. 30m
OLLAMA_KEEP_ALIVE=-1
# free the model's VRAM when Kageon exits
UNLOAD_ON_EXIT=true
# "thinking" = smarter but slower. Off unless you say "think about it" / "deep analysis"
THINK_DEFAULT=false
THINK_TIMEOUT=180

# --- Modes ---
# auto | gaming | normal   (a manual choice is remembered until you say "auto mode")
MODE_DEFAULT=auto
# Free VRAM is measured as if Kageon's own model were NOT loaded, so only games/apps count.
# auto = switch to gaming when there's less room than the normal model really needs (measured, ~5.6 GB
# for qwen3.5:9b) + VRAM_HEADROOM_GB, and back to normal above that + VRAM_HYSTERESIS_GB.
# Or put fixed numbers in GB, e.g. VRAM_GAMING_BELOW_GB=7.5
VRAM_GAMING_BELOW_GB=auto
VRAM_NORMAL_ABOVE_GB=auto
VRAM_HEADROOM_GB=1.5
VRAM_HYSTERESIS_GB=1.0
# back to normal only after it stays above the threshold this long (seconds):
NORMAL_AFTER_SECONDS=30
VRAM_POLL_SECONDS=5
# Switch to gaming mode the moment a game PROGRAM starts (anything running from a Steam / Epic / Riot /
# EA / Ubisoft / GOG / Xbox games folder). The VRAM check above stays as a backup.
GAME_DETECTION=true
# games installed somewhere else (comma-separated .exe names), e.g. GAME_PROCESSES=minecraft.exe, osu!.exe
GAME_PROCESSES=
# programs inside game folders that are NOT games and should be ignored, e.g. GAME_IGNORE=mytool.exe
GAME_IGNORE=
# Kageon says "Gaming mode on..." when the mode changes (never more often than ANNOUNCE_MIN_INTERVAL seconds)
ANNOUNCE_MODE_CHANGES=true
ANNOUNCE_MIN_INTERVAL=60

# --- Execution ---
# true = Kageon only logs actions (safe testing), nothing is launched/closed
DRY_RUN=false
CONFIRM_TIMEOUT=60
# understand simple commands (open/close/volume/yes/no) instantly, without the LLM
FAST_COMMANDS=true
# global shortcut that shuts Kageon down from anywhere (blank = off)
QUIT_HOTKEY=ctrl+shift+q
# crescent icon near the clock (Show PIN / Open log / Quit) + "Kageon is running" notification
TRAY_ENABLED=true
# when started with Windows: seconds to wait first (Wi-Fi, audio, Ollama)
AUTOSTART_DELAY=15

# --- Memory (stays on this PC in data/memory.db) ---
MEMORY_ENABLED=true
# how many remembered facts are given to the AI per request
MEMORY_MAX_FACTS=20

# --- Media & screen ---
# where "play ..." plays: youtube | youtube music | spotify
PLAY_SITE=youtube
# screenshots are shrunk to this size (px) before the AI looks at them
SCREEN_MAX_SIDE=1280

# --- Voice ---
VOICE_ENABLED=true
# auto = models/hey_kageon.onnx once it is trained, otherwise a temporary built-in phrase (shown at startup)
# Or a path to your own .onnx wake-word model.
WAKE_WORD_MODEL=auto
# 0..1, raise it (e.g. 0.6) if Kageon wakes up by accident, lower it (0.35) if it misses you
WAKE_THRESHOLD=0.5
# blank = Windows default microphone. Or a device number / name (python tools/check_setup.py lists them)
MIC_DEVICE=
# how long you must be silent before Kageon processes what you said (ms). Lower = snappier, but may cut you off
END_SILENCE_MS=700
# tiny | base | small | medium | large-v3   (small = good balance, supports Arabic + English)
WHISPER_MODEL=small
# auto = try NVIDIA GPU, fall back to CPU
WHISPER_DEVICE=auto
# true = always understand speech as English (recommended). false = auto-detect English/Arabic each time
ENGLISH_ONLY=true
# or force one language explicitly: en / ar (overrides ENGLISH_ONLY)
STT_LANGUAGE=
TTS_VOICE=en-GB-RyanNeural
TTS_VOICE_ARABIC=ar-SA-HamedNeural
SPEAK_RESPONSES=true
